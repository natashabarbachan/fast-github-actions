		{
			"name": "Get Donald Duck",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// SETUP",
							"const { code, status } = pm.response;",
							"const personagem = pm.response.json().data;",
							"",
							"pm.test(\"Status code é 200\", function () {",
							"    pm.expect(code).to.eql(200);",
							"});",
							"",
							"pm.test('Status is OK', function () {",
							"    pm.expect(status).to.eql('OK');",
							"});",
							"",
							"pm.test('Nome do personagem é \"Donald Duck\"', function () {",
							"    pm.expect(personagem.name).to.eql(\"Donald Duck\");",
							"});",
							"",
							"pm.test('O filme \"Pinocchio (2022 film)\" está presente nos filmes do personagem', function () {",
							"    var films = Array.isArray(personagem.films) ? personagem.films : [];",
							"    pm.expect(films).to.include(\"Pinocchio (2022 film)\");",
							"});",
							"",
							"pm.test(\"Enemies está vazio\", function () {",
							"    var enemies = Array.isArray(personagem.enemies) ? personagem.enemies : [];",
							"    pm.expect(enemies.length).to.eql(0);",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
